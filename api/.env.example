# local | staging | production. "production" refuses to start unless every value below is real (see app/config.py).
APP_ENV=local
# SQLite for quick local use. In production use any PostgreSQL, for example the Supabase pooler URL
# (postgresql+psycopg://user:password@host:6543/postgres?sslmode=require). Supabase is used as the database only.
DATABASE_URL=sqlite:///./campusplug.db
# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-only-use-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Public URL of the website (payment providers and email links send people back here)
WEB_URL=http://localhost:3000
# local = fake provider. paystack = Paystack (use TEST keys first)
PAYMENT_PROVIDER=local
PAYSTACK_SECRET_KEY=
# local = emails are kept in memory and sent nowhere (test). brevo = real email through Brevo (sign-up codes, password reset).
EMAIL_PROVIDER=local
BREVO_API_KEY=
# A sender address you verified in Brevo, for example no-reply@yourdomain.com
EMAIL_FROM=
EMAIL_FROM_NAME=Campus Plug
# local = photos and documents on this server's disk (test only; Render wipes it on every deploy).
# cloudinary = real storage. Values are on the Cloudinary dashboard (Settings > API Keys).
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Shows sign-up and reset codes on screen for local testing. Must be false in production.
EXPOSE_DEV_CODES=true
FEATURE_SMS=false
# Web push (npx web-push generate-vapid-keys). Without keys, push uses the local test adapter.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com
RATE_LIMIT_MULTIPLIER=1
