# local | staging | production
APP_ENV=local
# SQLite for quick local use, or the Supabase pooler URL (postgresql+psycopg://...)
DATABASE_URL=sqlite:///./campusplug.db
# local = built-in auth adapter (test only). supabase = verify Supabase JWTs.
AUTH_PROVIDER=local
JWT_SECRET=change-me-local-only-use-a-long-random-string
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=
CORS_ORIGINS=http://localhost:3000
# Public URL of the website (payment providers send buyers back here)
WEB_URL=http://localhost:3000
# local = fake provider. paystack = Paystack (use TEST keys first)
PAYMENT_PROVIDER=local
PAYSTACK_SECRET_KEY=
# Feature flags
FEATURE_SMS=false
EXPOSE_DEV_CODES=true
# Web push (npx web-push generate-vapid-keys). Without keys, push uses the local test adapter.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com
RATE_LIMIT_MULTIPLIER=1
